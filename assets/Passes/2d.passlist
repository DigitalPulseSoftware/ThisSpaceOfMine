passlist "2D"
{
    attachment "DepthBuffer"
    {
        format "PreferredDepthStencil"
    }

    attachment "ForwardOutput"
    {
        format "RGBA8"
    }

    pass "UI Pass"
    {
        impl "Forward"

        output "Output0" "ForwardOutput"
        {
            clearcolor "Viewer"
        }
        cleardepth "Viewer"

        depthstenciloutput "DepthBuffer"
        flag "LightShadowing"
    }

    attachment "Gamma corrected"
    {
        format "RGBA8"
    }

    pass "Gamma correction"
    {
        impl "PostProcess"
        {
            Shader "PostProcess.GammaCorrection"
        }

        input "Input0" "ForwardOutput"
        output "Output0" "Gamma corrected"
    }

    output "Gamma corrected"
}
