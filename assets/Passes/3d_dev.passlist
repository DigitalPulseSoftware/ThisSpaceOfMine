passlist "Forward Passlist"
{
    attachment "DepthBuffer"
    {
        format "Depth32F"
    }

    pass "DepthPrepass"
    {
        impl "Raster"
        {
            RenderQueues "ForwardOpaque"
        }

        cleardepth "Viewer"
        depthstenciloutput "DepthBuffer"
    }

    attachment "ForwardOutput"
    {
        format "RGBA16F"
    }

    pass "ForwardPass"
    {
        impl "Raster"
        {
            RenderQueues "ForwardOpaque + ForwardTransparent"
        }

        output "Output0" "ForwardOutput"
        {
            clearcolor "Viewer"
        }

        depthstencilinput "DepthBuffer"
        depthstenciloutput "DepthBuffer"
        flag "LightShadowing"
    }

    attachment "AtmosphereOutput"
    {
        format "RGBA16F"
    }

    pass "AtmospherePass"
    {
        impl "TSOM_AtmosphereScattering"

        input "Color" "ForwardOutput"
        input "Depth" "DepthBuffer"
        output "Output" "AtmosphereOutput"
    }

    attachment "ToneMapped"
    {
        format "RGBA8"
    }

    pass "Tone mapping"
    {
        impl "PostProcess"
        {
            Shader "TSOM.ToneMapping"
        }

        input "Input0" "AtmosphereOutput"
        output "Output0" "ToneMapped"
    }

    attachmentproxy "Debug draw output" "ToneMapped"
    attachmentproxy "DebugDraw depth output" "DepthBuffer"

    pass "Debug Draw"
    {
        impl "DebugDraw"
        input "Input" "ToneMapped"
        output "Output" "Debug draw output"
        depthstencilinput "DepthBuffer"
        depthstenciloutput "DebugDraw depth output"
    }

    attachmentproxy "ImGui draw output" "Debug draw output"

    pass "ImGui"
    {
        impl "ImGui"
        input "Input" "Debug draw output"
        output "Output" "ImGui draw output"
    }

    output "ImGui draw output"
}
