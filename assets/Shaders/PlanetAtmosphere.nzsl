[nzsl_version("1.1")]
module TSOM.PlanetAtmosphere;

import VertexShader from Engine.FullscreenVertex;

option MaxAtmosphereCount: u32;

const AtmosphereShape_RoundCube: u32 = 0;
const AtmosphereType_Torus: u32 = 1;

[layout(std140)]
struct AtmosphereScatteringData
{
	sunDir: vec3[f32],

	planetPosition: vec3[f32],

	shapeSettings: vec4[f32],
	shape: u32,

	atmosphereMaxHeight: f32,

	// scattering coeffs
	scatteringCoefficients: vec3[f32], //< = scatteringCofficients * wavelength^4
	mieScattering: f32,        // mie scattering direction, or how big the blob around the sun is

	// and the heights (how far to go up before the scattering has no effect)
	mieHeight: f32,         // and mie
	absorptionFalloff: f32, // how much the absorption decreases the further away it gets from the maximum height

	// and the steps (more looks better, but is slower)
	// the primary step has the most effect on looks
	primarySteps: i32,
	lightSteps: i32,
}

[layout(std140)]
struct PassData
{
	invProjectionMatrix: mat4[f32],
	invViewMatrix: mat4[f32],
	viewerPosition: vec3[f32],
	zNear: f32,

	atmosphereCount: u32,
	atmospheres: array[AtmosphereScatteringData, MaxAtmosphereCount]
}

external
{
	[binding(0)] passData: uniform[PassData],
	[binding(1)] colorTexture: sampler2D[f32],
	[binding(2)] depthTexture: sampler2D[f32],
}

// Fragment stage
struct VertOut
{
    [builtin(position)] position: vec4[f32],
	[builtin(frag_coord)] frag_coord: vec4[f32],
	[location(0)] uv: vec2[f32]
}

struct FragOut
{
	[location(0)] color: vec4[f32]
}

[entry(frag), depth_write(less)]
fn main(input: VertOut) -> FragOut
{
	let viewVector = passData.invProjectionMatrix * vec4[f32](input.uv * 2.0 - (1.0).xx, 0.0, 1.0);
	viewVector = passData.invViewMatrix * vec4[f32](viewVector.xyz, 0.0);

	let viewVector = normalize(viewVector.xyz);

	let cameraPos = passData.viewerPosition;

	let color = colorTexture.Sample(input.uv).rgb;
	let depth = depthTexture.Sample(input.uv).x;

	let linearDepth = passData.zNear / depth;

	// get the atmosphere color
	for atmosphereIndex in u32(0) -> passData.atmosphereCount
	{
		let atmosphere = passData.atmospheres[atmosphereIndex];

		if (atmosphere.shape == AtmosphereShape_RoundCube)
		{
			color = ComputeRoundCubeScattering(
				color,                          // scene color, the color of the current pixel being rendered
				cameraPos,                      // the position of the camera
				viewVector,                     // the camera vector (ray direction of this pixel)
				linearDepth,                    // max dist, essentially the scene depth
				atmosphere
			);
		}
		else if (atmosphere.shape == AtmosphereType_Torus)
		{
			color = ComputeTorusScattering(
				color,                          // scene color, the color of the current pixel being rendered
				cameraPos,                      // the position of the camera
				viewVector,                     // the camera vector (ray direction of this pixel)
				linearDepth,                    // max dist, essentially the scene depth
				atmosphere
			);
		}
	}

	let output: FragOut;
	output.color = vec4[f32](color, 1.0);

	return output;
}

// Based on https://www.youtube.com/watch?v=DxfEbulyFcY and https://www.shadertoy.com/view/wlBXWK
fn ComputeRoundCubeScattering(
	sceneColor: vec3[f32],		// the color of the scene
	viewerPos: vec3[f32], 			// the start of the ray (the camera position)
	viewerDir: vec3[f32], 			// the direction of the ray (the camera vector)
	maxDist: f32, 			    // the maximum distance the ray can travel (because something is in the way, like an object)
	atmosphere: AtmosphereScatteringData
) -> vec3[f32]
{
	let planetDims = atmosphere.shapeSettings.xyz;
	let planetCornerRadius = atmosphere.shapeSettings.w;

	let hitInfo = raySphere(atmosphere.planetPosition, atmosphere.atmosphereMaxHeight, viewerPos, viewerDir);
	if (hitInfo.x < 0.0)
		return sceneColor;

	let distanceToAtmosphere = hitInfo.x;
	let distanceThroughAtmosphere = min(hitInfo.y, maxDist - distanceToAtmosphere);

	if (distanceThroughAtmosphere <= 0.0)
		return sceneColor;

	let scatterPoint = viewerPos + viewerDir * distanceToAtmosphere;

	let stepSize = distanceThroughAtmosphere / f32(atmosphere.primarySteps - 1);

	let scatteredLight = (0.0).xxx;
	let viewRayOpticalDepth = 0.0;

    let allowMie = maxDist > hitInfo.y;
    let mu = dot(viewerDir, atmosphere.sunDir);
    let mumu = mu * mu;
    let gg = atmosphere.mieScattering * atmosphere.mieScattering;
    let phaseMie = select(allowMie, 3.0 / (25.1327412287 /* (8 * pi) */) * ((1.0 - gg) * (mumu + 1.0)) / (pow(1.0 + gg - 2.0 * mu * atmosphere.mieScattering, 1.5) * (2.0 + gg)), 0.0);

    let totalMie = (0.0).xxx;

	for i in 0 -> atmosphere.primarySteps
	{
		let sunRayLength = raySphere(atmosphere.planetPosition, atmosphere.atmosphereMaxHeight, scatterPoint, atmosphere.sunDir).y;
		let sunRayOpticalDepth = OpticalDepth_RoundBox(atmosphere.planetPosition, planetDims, planetCornerRadius, atmosphere.atmosphereMaxHeight, atmosphere.absorptionFalloff, scatterPoint, atmosphere.sunDir, sunRayLength, atmosphere.lightSteps);
		viewRayOpticalDepth = OpticalDepth_RoundBox(atmosphere.planetPosition, planetDims, planetCornerRadius, atmosphere.atmosphereMaxHeight, atmosphere.absorptionFalloff, scatterPoint, -viewerDir, stepSize * f32(i), atmosphere.lightSteps);
		let transmittance = exp(-(sunRayOpticalDepth + viewRayOpticalDepth) * atmosphere.scatteringCoefficients);
		let localDensity = DensityEvaluator_RoundBox(atmosphere.planetPosition, planetDims, planetCornerRadius, atmosphere.atmosphereMaxHeight, atmosphere.absorptionFalloff, scatterPoint);

	    totalMie += localDensity * transmittance * stepSize / atmosphere.mieHeight;

		scatteredLight += localDensity * transmittance * atmosphere.scatteringCoefficients * stepSize;
		scatterPoint += viewerDir * stepSize;
	}

	scatteredLight *= clamp(maxDist / (atmosphere.atmosphereMaxHeight * 2.0), 0.0, 1.0);

	let skyColor = scatteredLight + phaseMie.xxx * totalMie;
	let skyLuminance = ComputeLuminance(skyColor);
	let sceneColorLuminance = ComputeLuminance(sceneColor) + clamp((maxDist - atmosphere.atmosphereMaxHeight * 2.0) / atmosphere.atmosphereMaxHeight, 0.0, 1.0);

	let originalColorTransmittance = clamp(exp(-viewRayOpticalDepth) + (1.0 - skyLuminance), 0.0, 1.0);
	return originalColorTransmittance * sceneColor + skyColor * sceneColorLuminance;
}

fn ComputeTorusScattering(
	sceneColor: vec3[f32],		// the color of the scene
	viewerPos: vec3[f32], 			// the start of the ray (the camera position)
	viewerDir: vec3[f32], 			// the direction of the ray (the camera vector)
	maxDist: f32, 			    // the maximum distance the ray can travel (because something is in the way, like an object)
	atmosphere: AtmosphereScatteringData
) -> vec3[f32]
{
	let torus = atmosphere.shapeSettings.xy; //< radius / thickness

	//let hitInfo = rayTorus((viewerPos - atmosphere.planetPosition).xzy, viewerDir.xzy, vec2[f32](torus.x * 0.5, atmosphereMaxHeight));	
	//let hitInfo = raySphere(atmosphere.planetPosition, torus.x * 0.5 + atmosphere.atmosphereMaxHeight, viewerPos, viewerDir);
	//if (hitInfo.x < 0.0)
	//	return sceneColor;

	let hitInfo = raySphere(atmosphere.planetPosition, torus.y + atmosphere.atmosphereMaxHeight, viewerPos, viewerDir);
	if (hitInfo.x < 0.0)
		return sceneColor;

	let distanceToAtmosphere = hitInfo.x;
	let distanceThroughAtmosphere = min(hitInfo.y, maxDist - distanceToAtmosphere);

	if (distanceThroughAtmosphere <= 0.0)
		return sceneColor;

	let scatterPoint = viewerPos + viewerDir * distanceToAtmosphere;

	let stepSize = distanceThroughAtmosphere / f32(atmosphere.primarySteps - 1);

	let scatteredLight = (0.0).xxx;
	let viewRayOpticalDepth = 0.0;

    let allowMie = maxDist > hitInfo.y;
    let mu = dot(viewerDir, atmosphere.sunDir);
    let mumu = mu * mu;
    let gg = atmosphere.mieScattering * atmosphere.mieScattering;
    let phaseMie = select(allowMie, 3.0 / (25.1327412287 /* (8 * pi) */) * ((1.0 - gg) * (mumu + 1.0)) / (pow(1.0 + gg - 2.0 * mu * atmosphere.mieScattering, 1.5) * (2.0 + gg)), 0.0);

    let totalMie = (0.0).xxx;

	for i in 0 -> atmosphere.primarySteps
	{
		let sunRayLength = raySphere(atmosphere.planetPosition, atmosphere.atmosphereMaxHeight, scatterPoint, atmosphere.sunDir).y;
		let sunRayOpticalDepth = OpticalDepth_Torus(atmosphere.planetPosition, torus, atmosphere.atmosphereMaxHeight, atmosphere.absorptionFalloff, scatterPoint, atmosphere.sunDir, sunRayLength, atmosphere.lightSteps);
		viewRayOpticalDepth = OpticalDepth_Torus(atmosphere.planetPosition, torus, atmosphere.atmosphereMaxHeight, atmosphere.absorptionFalloff, scatterPoint, -viewerDir, stepSize * f32(i), atmosphere.lightSteps);
		let transmittance = exp(-(sunRayOpticalDepth + viewRayOpticalDepth) * atmosphere.scatteringCoefficients);
		let localDensity = DensityEvaluator_Torus(atmosphere.planetPosition, torus, atmosphere.atmosphereMaxHeight, atmosphere.absorptionFalloff, scatterPoint);

	    totalMie += localDensity * transmittance * stepSize / atmosphere.mieHeight;

		scatteredLight += localDensity * transmittance * atmosphere.scatteringCoefficients * stepSize;
		scatterPoint += viewerDir * stepSize;
	}

	scatteredLight *= clamp(maxDist / (atmosphere.atmosphereMaxHeight * 2.0), 0.0, 1.0);

	let skyColor = scatteredLight + phaseMie.xxx * totalMie;
	let skyLuminance = ComputeLuminance(skyColor);
	let sceneColorLuminance = ComputeLuminance(sceneColor) + clamp((maxDist - atmosphere.atmosphereMaxHeight * 2.0) / atmosphere.atmosphereMaxHeight, 0.0, 1.0);

	let originalColorTransmittance = clamp(exp(-viewRayOpticalDepth) + (1.0 - skyLuminance), 0.0, 1.0);
	return originalColorTransmittance * sceneColor + skyColor * sceneColorLuminance;
}

fn sdRoundBox(pos: vec3[f32], dims: vec3[f32], cornerRadius: f32) -> f32
{
	let q = abs(pos) - dims + cornerRadius.xxx;
	return length(max(q, (0.0).xxx)) + min(max(q.x, max(q.y, q.z)), 0.0) - cornerRadius;
}

fn DensityEvaluator_RoundBox(planetCenter: vec3[f32], planetDims: vec3[f32], planetCornerRadius: f32, atmosphereMaxHeight: f32, densityFallOff: f32, samplePoint: vec3[f32]) -> f32
{
	let heightAboveSurface = sdRoundBox(samplePoint - planetCenter, planetDims, planetCornerRadius);
	let clampedHeight = max(0.0, heightAboveSurface);
	let height01 = clampedHeight / (atmosphereMaxHeight); //< FIXME

	return exp(-height01 * densityFallOff) * (1.0 - height01);
}

fn OpticalDepth_RoundBox(planetCenter: vec3[f32], planetDims: vec3[f32], planetCornerRadius: f32, atmosphereMaxHeight: f32, densityFallOff: f32, rayOrigin: vec3[f32], rayDirection: vec3[f32], rayLength: f32, secondaryStepCount: i32) -> f32
{
	let densitySamplePoint = rayOrigin;
	let stepSize = rayLength / f32(secondaryStepCount - 1);

	let opticalDepth = 0.0;

	for i in 0 -> secondaryStepCount
	{
		let localDensity = DensityEvaluator_RoundBox(planetCenter, planetDims, planetCornerRadius, atmosphereMaxHeight, densityFallOff, densitySamplePoint);

		opticalDepth += localDensity * stepSize;
		densitySamplePoint += rayDirection * stepSize;
	}

	return opticalDepth;
}

fn sdTorus(pos: vec3[f32], torus: vec2[f32]) -> f32
{
	let q = vec2[f32](length(pos.xz) - torus.x, pos.y);
	return length(q) - torus.y;
}

fn DensityEvaluator_Torus(planetCenter: vec3[f32], torus: vec2[f32], atmosphereMaxHeight: f32, densityFallOff: f32, samplePoint: vec3[f32]) -> f32
{
	let heightAboveSurface = sdTorus(samplePoint - planetCenter, vec2[f32](torus.x * 0.5, 0.0));
	let clampedHeight = max(0.0, heightAboveSurface);
	let height01 = clampedHeight / (atmosphereMaxHeight); //< FIXME

	return exp(-height01 * densityFallOff) * (1.0 - height01);
}

fn OpticalDepth_Torus(planetCenter: vec3[f32], torus: vec2[f32], atmosphereMaxHeight: f32, densityFallOff: f32, rayOrigin: vec3[f32], rayDirection: vec3[f32], rayLength: f32, secondaryStepCount: i32) -> f32
{
	let densitySamplePoint = rayOrigin;
	let stepSize = rayLength / f32(secondaryStepCount - 1);

	let opticalDepth = 0.0;

	for i in 0 -> secondaryStepCount
	{
		let localDensity = DensityEvaluator_Torus(planetCenter, torus, atmosphereMaxHeight, densityFallOff, densitySamplePoint);

		opticalDepth += localDensity * stepSize;
		densitySamplePoint += rayDirection * stepSize;
	}

	return opticalDepth;
}

// https://iquilezles.org/articles/intersectors/
fn aabbIntersect(rayOrigin: vec3[f32], rayDirection: vec3[f32], boxSize: vec3[f32]) -> vec2[f32]
{
    let m = 1.0 / rayDirection; // can precompute if traversing a set of aligned boxes
    let n = m * rayOrigin;   // can precompute if traversing a set of aligned boxes
    let k = abs(m) * boxSize;
    let t1 = -n - k;
    let t2 = -n + k;
    let tN = max( max( t1.x, t1.y ), t1.z );
    let tF = min( min( t2.x, t2.y ), t2.z );

    return vec2[f32](tN, tF);
}

fn raySphere(spherePos: vec3[f32], sphereRadius: f32, rayOrigin: vec3[f32], rayDirection: vec3[f32]) -> vec2[f32]
{
	let offset = rayOrigin - spherePos;
	let a = 1.0; // Set to dot(rayDirection, rayDirection) if rayDirection might not be normalized
	let b = 2.0 * dot(offset, rayDirection);
	let c = dot(offset, offset) - sphereRadius * sphereRadius;
	let d = b * b - 4.0 * a * c; // Discriminant from quadratic formula

	// Number of intersections: 0 when d < 0; 1 when d = 0; 2 when d > 0
	if (d > 0.0)
	{
		let s = sqrt(d);
		let dstToSphereNear = max(0.0, (-b - s) / (2.0 * a));
		let dstToSphereFar = (-b + s) / (2.0 * a);

		// Ignore intersections that occur behind the ray
		if (dstToSphereFar >= 0.0) {
			return vec2(dstToSphereNear, dstToSphereFar - dstToSphereNear);
		}
	}
	// Ray did not intersect sphere
	return vec2(-1.0, -1.0);
}

// https://www.shadertoy.com/view/3XdyRj
fn solve_cubic(a1: f32, a2: f32, a3: f32) -> f32
{
	let A2 = a1 * a1;

	let Q = (A2 - 3.0 * a2) * (1.0/ 9.0);
	let RR = (a1 * (A2 - 4.5 * a2) + 13.5 * a3) * (1.0/ 27.0);
	let Q3 = Q * Q * Q;
	let R2 = RR * RR;
	let d = Q3 - R2;
	let an = a1 * (1.0/3.0);
	if (d >= 0.0)
	{
		// 3 real roots, but only use the largest one!
		d = RR * rsqrt(Q3);
		let theta = acos(d) * (1. / 3.);
		let sQ = -2. * sqrt(Q);
        let s = 2.09439510239320;
        let sol = sQ * cos(theta.xxx + vec3(0.0, s, -s)) - an.xxx;
        return max(sol.x, max(sol.y, sol.z));
	}
    let S = sqrt(-d) + abs(RR);
	let sQ = pow(S, 1./3.);
	let t = (sQ + Q / sQ) * sign(-RR);
	let res = t - an;
    return res;
}

// https://en.wikipedia.org/wiki/Sorting_network
fn sort2(val: vec2[f32]) -> vec2[f32]
{
	return vec2(min(val.x, val.y), max(val.x, val.y));
}

fn sort3(val: vec3[f32]) -> vec3[f32]
{
	val.xy = sort2(val.xy);
	val.yz = sort2(val.yz);
	val.xy = sort2(val.xy);
	return val;
}

fn sort4(val: vec4[f32]) -> vec4[f32]
{
	val.xz = sort2(val.xz);
	val.yw = sort2(val.yw);

	val.xy = sort2(val.xy);
	val.zw = sort2(val.zw);

	val.yz = sort2(val.yz);

	return val;
}

fn rayTorus(rayOrigin: vec3[f32], rayDirection: vec3[f32], torus: vec2[f32]) -> vec2[f32]
{
    let Ra2 = torus.x*torus.x;
    let ra2 = torus.y*torus.y;
	
    let x = dot(rayOrigin,rayOrigin);
    let d = dot(rayOrigin,rayDirection);

    // bounding sphere
    {
        let r = torus.x + torus.y;
        let h = d*d - x + r*r;
        if (h < 0.0)
			return (-1.0).xx;
        if (d > 0.0 && r*r < x)
			return (-1.0).xx;
    }
    
	// find quartic equation in the form (t² + 2pt + q)² = 4(at² + 2bt + c)
    let p = d;
    let q = x + Ra2 - ra2; // >= Ra2 - ra2 >= 0
    // these forms, which look like cancelation is happening are somehow better.
    let a = Ra2 * (1.0 - rayDirection.z*rayDirection.z); // >= 0
    let b = Ra2 * (d - rayDirection.z*rayOrigin.z); // >= 0
    let c = Ra2 * (x - rayOrigin.z*rayOrigin.z); // >= 0
    // now get the resolvent cubic using (t² + 2pt + q + 2m)² = 4(at² + 2bt + c + m² + m(t² + 2pt + q))
    // = 4((a+m)t² + 2(b+mp)t + c + m² + mq) the resolvent cubic is the discriminant of this
    // -> 0 = (b+mp)² - (a + m)(c + m² + mq)
    // -> 0 = ac - b² + (aq + c - 2bp)m + (a + q - p²)m² + m³  (normalized cubic)
    // since in the next step, a+m is needed, transform the cubic using m = n-a
    // -> 0 = ac - b² + (aq + c - 2bp)(n - a) + (a + q - p²)(n² - 2na + a²) + n³ - 3n²a + 3na² - a³  (normalized cubic)
    // -> 0 = -(ap - b)² + (c + a² + 2p(ap - b) - aq) n + (q - 2a - p²) n² + n³
	// now the equation is Q := sqrt(a+m) = sqrt(n)
    // (t² + 2pt + q + 2m)² = (2*Q*t + 2*(b+mp)/Q)²
    // redefine a and b for the right side to be = (2at+b)² and don't forget the +2m on the left side.
    let k = a*p - b;
	let c0 = -k * k;
    let c1 = c + a*(a - q) + 2.*p*k;
    let c2 = q - 2.*a - p*p;
    if (abs(c0 / c1) > 0.0000001)
	{ // on the CPU this can be implemented as c0 + c1 != c1, but the GPU compiler apparently optimizes it away :(
        // the flipping of the problem isn't needed in the cubic solver here!
        let n = solve_cubic(c2, c1, c0);
        // do one Newton iteration to improve the precision (this solves all precision issues)
        n -= (c0 + n*(c1 + n*(c2 + n)))/(c1 + n*(c2*2. + n*3.));
        if (n < 0.)
			return (-1.0).xx;
        let Q = sqrt(n);
        b = 2. * (Q * p - k / Q);
        q += 2.*(n - a);
        a = Q;
    }
    else
	{
        //test_param = 0.0;
        // for k = 0, the solution is n = 0. It is unstable around k = 0.
        // remember c0 = -k*k
        let n = -c0 / c1;
        if (n < 0.)
			return (-1.0).xx;

        let C = sqrt(c1);
        let Q = k / C; // cancel the sqrt
        b = 2.*(Q * p - C);
        q += 2.*(n - a);
        a = Q;
    }

    // now take the sqrt on both sides (introducing a sign)
    // and solve the resulting normalized quadratic for both signs.
    // t² + 2(p-s*a)t + q - s*b = 0
	let dist = vec4(-1.0, -1.0, -1.0, -1.0);

	let distIdx = 0;

	for i in 0 -> 2
	{
        let p2 = p - a;
        let pp = p2 * p2;
        let q2 = q - b;
        let h = pp - q2;
        a = -a;
        b = -b;
        if (h < 0.0)
			continue;

        h = sqrt(h);
		for j in 0 -> 2
		{
            let t1 = -p2 + h;
			if (t1 >= 0.0)
			{
				dist[distIdx] = t1;
				distIdx += 1;
			}

            h = -h;
        }
    }

	if (distIdx >= 4)
		// Outside the torus, two enter points and two exit points
		return sort4(dist).xw;
	else if (distIdx == 3)
		// Inside the torus, one exit point and one enter/exit point
		return vec2[f32](0.0, max(dist.x, max(dist.y, dist.z)));
	else if (distIdx == 2)
		// Outside the torus, one enter point and one exit point
		return sort2(dist.xy);
	else if (distIdx == 1)
		// Inside the torus, one exit point
		return vec2[f32](0.0, dist.x);
	else
		return vec2[f32](-1.0, -1.0);
}

fn ComputeLuminance(color: vec3[f32]) -> f32
{
	// https://stackoverflow.com/questions/596216/formula-to-determine-perceived-brightness-of-rgb-color
	const LuminanceFactors = vec3[f32](0.2125, 0.7154, 0.0721);
	return dot(color, LuminanceFactors);
}

/*fn rayTorus(rayOrigin: vec3[f32], rayDirection: vec3[f32], torus: vec2[f32]) -> f32
{
    let po = 1.0;
    let tx = 0.0;
    let Ra2 = torus.x * torus.x;
    let ra2 = torus.y * torus.y;
    let tra = torus.x + torus.y;

    let m = dot(rayOrigin, rayOrigin);
    let n = dot(rayOrigin, rayDirection);

    // bounding sphere
	let h = n*n - m + tra*tra;
	if (h < 0.0)
		return -1.0;

	tx = -n - sqrt(h); // start ray from bounding sphere surface 
    if(tx > 0.0)     // if outside of sphere
    {
		tx -= tra*0.01; // backtrack 1%
		m  += tx*(2.0*n + tx);
		n  += tx;
		rayOrigin += tx * rayDirection;
    }
    else
 		tx = 0.0;
    
