[nzsl_version("1.1")]
module TSOM.PlanetAtmosphere;

import VertexShader from Engine.FullscreenVertex;

option MaxAtmosphereCount: u32;

const AtmosphereType_RoundCube: u32 = 0;
const AtmosphereType_Torus: u32 = 1;

[layout(std140)]
struct AtmosphereScatteringData
{
	sunDir: vec3[f32],

	planetPosition: vec3[f32],
	planetSettings: vec4[f32],
	atmosphereMaxHeight: f32,
	atmosphereType: u32,

	// scattering coeffs
	mieScattering: f32,        // mie scattering direction, or how big the blob around the sun is

	// and the heights (how far to go up before the scattering has no effect)
	rayleighHeight: f32,    // rayleigh height
	mieHeight: f32,         // and mie
	absorptionFalloff: f32, // how much the absorption decreases the further away it gets from the maximum height

	// and the steps (more looks better, but is slower)
	// the primary step has the most effect on looks
	primarySteps: i32,
	lightSteps: i32,
}

[layout(std140)]
struct PassData
{
	invProjectionMatrix: mat4[f32],
	invViewMatrix: mat4[f32],
	viewerPosition: vec3[f32],
	zNear: f32,

	atmosphereCount: u32,
	atmospheres: array[AtmosphereScatteringData, MaxAtmosphereCount]
}

external
{
	[binding(0)] passData: uniform[PassData],
	[binding(1)] colorTexture: sampler2D[f32],
	[binding(2)] depthTexture: sampler2D[f32],
}

// Fragment stage
struct VertOut
{
    [builtin(position)] position: vec4[f32],
	[builtin(frag_coord)] frag_coord: vec4[f32],
	[location(0)] uv: vec2[f32]
}

struct FragOut
{
	[location(0)] color: vec4[f32]
}

[entry(frag), depth_write(less)]
fn main(input: VertOut) -> FragOut
{
	let viewVector = passData.invProjectionMatrix * vec4[f32](input.uv * 2.0 - (1.0).xx, 0.0, 1.0);
	viewVector = passData.invViewMatrix * vec4[f32](viewVector.xyz, 0.0);

	let viewVector = normalize(viewVector.xyz);

	let cameraPos = passData.viewerPosition;

	let color = colorTexture.Sample(input.uv).rgb;
	let depth = depthTexture.Sample(input.uv).x;

	let linearDepth = passData.zNear / depth;

	// get the atmosphere color
	for atmosphereIndex in u32(0) -> passData.atmosphereCount
	{
		let atmosphere = passData.atmospheres[atmosphereIndex];

		if (atmosphere.atmosphereType == AtmosphereType_RoundCube)
		{
			color = ComputeRoundCubeScattering(
				cameraPos,                      // the position of the camera
				viewVector,                     // the camera vector (ray direction of this pixel)
				linearDepth,                    // max dist, essentially the scene depth
				color,                          // scene color, the color of the current pixel being rendered
				atmosphere.sunDir,              // light direction
				atmosphere.planetPosition,      // center of the planet
				atmosphere.planetSettings.xyz,  // planet box dimensions
				atmosphere.planetSettings.w,    // planet box corner radius
				atmosphere.atmosphereMaxHeight, // max height of the atmosphere (for culling)
				atmosphere.mieScattering,       // Mie preferred scattering direction
				atmosphere.mieHeight,           // Mie scale height
				atmosphere.absorptionFalloff,   // how fast the absorption falls off from the absorption height 
				atmosphere.primarySteps,        // steps in the ray direction 
				atmosphere.lightSteps           // steps in the light direction
			);
		}
		else if (atmosphere.atmosphereType == AtmosphereType_Torus)
		{
			color = ComputeTorusScattering(
				cameraPos,                      // the position of the camera
				viewVector,                     // the camera vector (ray direction of this pixel)
				linearDepth,                    // max dist, essentially the scene depth
				color,                          // scene color, the color of the current pixel being rendered
				atmosphere.sunDir,              // light direction
				atmosphere.planetPosition,      // center of the planet
				atmosphere.planetSettings.xy,   // torus parameters
				/*atmosphere.atmosphereMaxHeight*/ 140.0, // max height of the atmosphere (for culling)
				atmosphere.mieScattering,       // Mie preferred scattering direction
				atmosphere.mieHeight,           // Mie scale height
				/*atmosphere.absorptionFalloff*/ 10.0,   // how fast the absorption falls off from the absorption height 
				atmosphere.primarySteps,        // steps in the ray direction 
				atmosphere.lightSteps           // steps in the light direction
			);
		}
	}

	let output: FragOut;
	output.color = vec4[f32](color, 1.0);

	return output;
}

const HEIGHT_SCALE = 64.0;
const HEIGHT_SCALE_INV = 1.0 / HEIGHT_SCALE;

const waveLengths = vec3[f32](700.0, 530.0, 440.0);
const scatteringCoefficients_1 = (400.0).xxx / waveLengths;
const scatteringCoefficients = scatteringCoefficients_1 * scatteringCoefficients_1 * scatteringCoefficients_1 * scatteringCoefficients_1;

fn RoundBoxUp(pos: vec3[f32], cornerRadius: f32) -> vec3[f32]
{
	let distToCenter = max(max(abs(pos.x), abs(pos.y)), abs(pos.z));

	let innerReductionSize = max(distToCenter - max(cornerRadius, 1.0), 0.0);
	let innerBoxMin = -innerReductionSize.xxx;
	let innerBoxMax = innerReductionSize.xxx;

	let innerPos = clamp(pos, innerBoxMin, innerBoxMax);
	return normalize(pos - innerPos);
}

// Based on https://www.youtube.com/watch?v=DxfEbulyFcY and https://www.shadertoy.com/view/wlBXWK
fn ComputeRoundCubeScattering(
	viewerPos: vec3[f32], 			// the start of the ray (the camera position)
	viewerDir: vec3[f32], 			// the direction of the ray (the camera vector)
	maxDist: f32, 			    // the maximum distance the ray can travel (because something is in the way, like an object)
	sceneColor: vec3[f32],		// the color of the scene
	sunDir: vec3[f32], 		// the direction of the light
	planetOrigin: vec3[f32], // the position of the planet
	planetDims: vec3[f32],     // the planet dimensions
	planetCornerRadius: f32,  // the planet corner radius
	atmosphereMaxHeight: f32,   // the atmosphere max height (starting from planet dimensions)
	mieScattering: f32, 					// the direction mie scatters the light in (like a cone). closer to -1 means more towards a single direction
	heightMie: f32, 			// the same, but for mie
	densityFallOff: f32,	// how fast the absorption falls off from the absorption height
	primaryRayCount: i32, 				// the amount of steps along the 'primary' ray, more looks better but slower
	secondaryRayCount: i32 				// the amount of steps along the light ray, more looks better but slower
) -> vec3[f32]
{
	let hitInfo = raySphere(planetOrigin, atmosphereMaxHeight, viewerPos, viewerDir);
	if (hitInfo.x < 0.0)
		return sceneColor;

	let distanceToAtmosphere = hitInfo.x;
	let distanceThroughAtmosphere = min(hitInfo.y, maxDist - distanceToAtmosphere);

	if (distanceThroughAtmosphere <= 0.0)
		return sceneColor;

	let scatterPoint = viewerPos + viewerDir * distanceToAtmosphere;

	let stepSize = distanceThroughAtmosphere / f32(primaryRayCount - 1);

	let scatteredLight = (0.0).xxx;
	let viewRayOpticalDepth = 0.0;

    let allowMie = maxDist > hitInfo.y;
    let mu = dot(viewerDir, sunDir);
    let mumu = mu * mu;
    let gg = mieScattering * mieScattering;
    let phaseMie = select(allowMie, 3.0 / (25.1327412287 /* (8 * pi) */) * ((1.0 - gg) * (mumu + 1.0)) / (pow(1.0 + gg - 2.0 * mu * mieScattering, 1.5) * (2.0 + gg)), 0.0);

    let totalMie = (0.0).xxx;

	for i in 0 -> primaryRayCount
	{
		let scatterStrength = 1.0;

		let sunRayLength = raySphere(planetOrigin, atmosphereMaxHeight, scatterPoint, sunDir).y;
		let sunRayOpticalDepth = OpticalDepth_RoundBox(planetOrigin, planetDims, planetCornerRadius, atmosphereMaxHeight, densityFallOff, scatterPoint, sunDir, sunRayLength, secondaryRayCount);
		viewRayOpticalDepth = OpticalDepth_RoundBox(planetOrigin, planetDims, planetCornerRadius, atmosphereMaxHeight, densityFallOff, scatterPoint, -viewerDir, stepSize * f32(i), secondaryRayCount);
		let transmittance = exp(-(sunRayOpticalDepth + viewRayOpticalDepth) * scatteringCoefficients * scatterStrength);
		let localDensity = DensityEvaluator_RoundBox(planetOrigin, planetDims, planetCornerRadius, atmosphereMaxHeight, densityFallOff, scatterPoint);

	    totalMie += localDensity * transmittance * stepSize / heightMie;

		scatteredLight += localDensity * transmittance * scatteringCoefficients * scatterStrength * stepSize;
		scatterPoint += viewerDir * stepSize;
	}

	scatteredLight *= clamp(maxDist / (atmosphereMaxHeight * 2.0), 0.0, 1.0);

	let skyColor = scatteredLight + phaseMie.xxx * totalMie;
	let skyLuminance = dot(skyColor, vec3[f32](0.2125, 0.7154, 0.0721));
	let sceneColorLuminance = dot(sceneColor, vec3[f32](0.2125, 0.7154, 0.0721)) + clamp((maxDist - atmosphereMaxHeight * 2.0) / atmosphereMaxHeight, 0.0, 1.0);

	let originalColorTransmittance = clamp(exp(-viewRayOpticalDepth) + (1.0 - skyLuminance), 0.0, 1.0);
	return originalColorTransmittance * sceneColor + skyColor * sceneColorLuminance;
}

fn ComputeTorusScattering(
	viewerPos: vec3[f32], 			// the start of the ray (the camera position)
	viewerDir: vec3[f32], 			// the direction of the ray (the camera vector)
	maxDist: f32, 			    // the maximum distance the ray can travel (because something is in the way, like an object)
	sceneColor: vec3[f32],		// the color of the scene
	sunDir: vec3[f32], 		// the direction of the light
	planetOrigin: vec3[f32], // the position of the planet
	torus: vec2[f32],  // the torus parameters (radius / thickness)
	atmosphereMaxHeight: f32,   // the atmosphere max height (starting from planet dimensions)
	mieScattering: f32, 					// the direction mie scatters the light in (like a cone). closer to -1 means more towards a single direction
	heightMie: f32, 			// the same, but for mie
	densityFallOff: f32,	// how fast the absorption falls off from the absorption height
	primaryRayCount: i32, 				// the amount of steps along the 'primary' ray, more looks better but slower
	secondaryRayCount: i32 				// the amount of steps along the light ray, more looks better but slower
) -> vec3[f32]
{
	let dist = rayTorus(viewerPos, viewerDir, torus);
	if (dist < 0.0)
		return sceneColor;

	return sceneColor + vec3[f32](0.0, 0.1, 0.0);

	let hitInfo = raySphere(planetOrigin, atmosphereMaxHeight, viewerPos, viewerDir);
	if (hitInfo.x < 0.0)
		return sceneColor;

	let distanceToAtmosphere = hitInfo.x;
	let distanceThroughAtmosphere = min(hitInfo.y, maxDist - distanceToAtmosphere);

	if (distanceThroughAtmosphere <= 0.0)
		return sceneColor;

	let scatterPoint = viewerPos + viewerDir * distanceToAtmosphere;

	let stepSize = distanceThroughAtmosphere / f32(primaryRayCount - 1);

	let scatteredLight = (0.0).xxx;
	let viewRayOpticalDepth = 0.0;

    let allowMie = maxDist > hitInfo.y;
    let mu = dot(viewerDir, sunDir);
    let mumu = mu * mu;
    let gg = mieScattering * mieScattering;
    let phaseMie = select(allowMie, 3.0 / (25.1327412287 /* (8 * pi) */) * ((1.0 - gg) * (mumu + 1.0)) / (pow(1.0 + gg - 2.0 * mu * mieScattering, 1.5) * (2.0 + gg)), 0.0);

    let totalMie = (0.0).xxx;

	for i in 0 -> primaryRayCount
	{
		let scatterStrength = 1.0;

		let sunRayLength = raySphere(planetOrigin, atmosphereMaxHeight, scatterPoint, sunDir).y;
		let sunRayOpticalDepth = OpticalDepth_Torus(planetOrigin, torus, atmosphereMaxHeight, densityFallOff, scatterPoint, sunDir, sunRayLength, secondaryRayCount);
		viewRayOpticalDepth = OpticalDepth_Torus(planetOrigin, torus, atmosphereMaxHeight, densityFallOff, scatterPoint, -viewerDir, stepSize * f32(i), secondaryRayCount);
		let transmittance = exp(-(sunRayOpticalDepth + viewRayOpticalDepth) * scatteringCoefficients * scatterStrength);
		let localDensity = DensityEvaluator_Torus(planetOrigin, torus, atmosphereMaxHeight, densityFallOff, scatterPoint);

	    totalMie += localDensity * transmittance * stepSize / heightMie;

		scatteredLight += localDensity * transmittance * scatteringCoefficients * scatterStrength * stepSize;
		scatterPoint += viewerDir * stepSize;
	}

	scatteredLight *= clamp(maxDist / (atmosphereMaxHeight * 2.0), 0.0, 1.0);

	let skyColor = scatteredLight + phaseMie.xxx * totalMie;
	let skyLuminance = dot(skyColor, vec3[f32](0.2125, 0.7154, 0.0721));
	let sceneColorLuminance = dot(sceneColor, vec3[f32](0.2125, 0.7154, 0.0721)) + clamp((maxDist - atmosphereMaxHeight * 2.0) / atmosphereMaxHeight, 0.0, 1.0);

	let originalColorTransmittance = clamp(exp(-viewRayOpticalDepth) + (1.0 - skyLuminance), 0.0, 1.0);
	return originalColorTransmittance * sceneColor + skyColor * sceneColorLuminance;
}

fn sdRoundBox(pos: vec3[f32], dims: vec3[f32], cornerRadius: f32) -> f32
{
	let q = abs(pos) - dims + cornerRadius.xxx;
	return length(max(q, (0.0).xxx)) + min(max(q.x, max(q.y, q.z)), 0.0) - cornerRadius;
}

fn DensityEvaluator_RoundBox(planetCenter: vec3[f32], planetDims: vec3[f32], planetCornerRadius: f32, atmosphereMaxHeight: f32, densityFallOff: f32, samplePoint: vec3[f32]) -> f32
{
	let heightAboveSurface = sdRoundBox(samplePoint - planetCenter, planetDims, planetCornerRadius);
	let clampedHeight = max(0.0, heightAboveSurface);
	let height01 = clampedHeight / (atmosphereMaxHeight); //< FIXME

	return exp(-height01 * densityFallOff) * (1.0 - height01);
}

fn OpticalDepth_RoundBox(planetCenter: vec3[f32], planetDims: vec3[f32], planetCornerRadius: f32, atmosphereMaxHeight: f32, densityFallOff: f32, rayOrigin: vec3[f32], rayDirection: vec3[f32], rayLength: f32, secondaryStepCount: i32) -> f32
{
	let densitySamplePoint = rayOrigin;
	let stepSize = rayLength / f32(secondaryStepCount - 1);

	let opticalDepth = 0.0;

	for i in 0 -> secondaryStepCount
	{
		let localDensity = DensityEvaluator_RoundBox(planetCenter, planetDims, planetCornerRadius, atmosphereMaxHeight, densityFallOff, densitySamplePoint);

		opticalDepth += localDensity * stepSize;
		densitySamplePoint += rayDirection * stepSize;
	}

	return opticalDepth;
}

fn sdTorus(pos: vec3[f32], torus: vec2[f32]) -> f32
{
	let q = vec2[f32](length(pos.xz) - torus.x, pos.y);
	return length(q) - torus.y;
}

fn DensityEvaluator_Torus(planetCenter: vec3[f32], torus: vec2[f32], atmosphereMaxHeight: f32, densityFallOff: f32, samplePoint: vec3[f32]) -> f32
{
	let heightAboveSurface = sdTorus(samplePoint - planetCenter, torus);
	let clampedHeight = max(0.0, heightAboveSurface);
	let height01 = clampedHeight / (atmosphereMaxHeight); //< FIXME

	return exp(-height01 * densityFallOff) * (1.0 - height01);
}

fn OpticalDepth_Torus(planetCenter: vec3[f32], torus: vec2[f32], atmosphereMaxHeight: f32, densityFallOff: f32, rayOrigin: vec3[f32], rayDirection: vec3[f32], rayLength: f32, secondaryStepCount: i32) -> f32
{
	let densitySamplePoint = rayOrigin;
	let stepSize = rayLength / f32(secondaryStepCount - 1);

	let opticalDepth = 0.0;

	for i in 0 -> secondaryStepCount
	{
		let localDensity = DensityEvaluator_Torus(planetCenter, torus, atmosphereMaxHeight, densityFallOff, densitySamplePoint);

		opticalDepth += localDensity * stepSize;
		densitySamplePoint += rayDirection * stepSize;
	}

	return opticalDepth;
}

// https://iquilezles.org/articles/intersectors/
fn aabbIntersect(rayOrigin: vec3[f32], rayDirection: vec3[f32], boxSize: vec3[f32]) -> vec2[f32]
{
    let m = 1.0 / rayDirection; // can precompute if traversing a set of aligned boxes
    let n = m * rayOrigin;   // can precompute if traversing a set of aligned boxes
    let k = abs(m) * boxSize;
    let t1 = -n - k;
    let t2 = -n + k;
    let tN = max( max( t1.x, t1.y ), t1.z );
    let tF = min( min( t2.x, t2.y ), t2.z );

    return vec2[f32](tN, tF);
}

fn raySphere(spherePos: vec3[f32], sphereRadius: f32, rayOrigin: vec3[f32], rayDirection: vec3[f32]) -> vec2[f32]
{
	let offset = rayOrigin - spherePos;
	let a = 1.0; // Set to dot(rayDirection, rayDirection) if rayDirection might not be normalized
	let b = 2.0 * dot(offset, rayDirection);
	let c = dot(offset, offset) - sphereRadius * sphereRadius;
	let d = b * b - 4.0 * a * c; // Discriminant from quadratic formula

	// Number of intersections: 0 when d < 0; 1 when d = 0; 2 when d > 0
	if (d > 0.0)
	{
		let s = sqrt(d);
		let dstToSphereNear = max(0.0, (-b - s) / (2.0 * a));
		let dstToSphereFar = (-b + s) / (2.0 * a);

		// Ignore intersections that occur behind the ray
		if (dstToSphereFar >= 0.0) {
			return vec2(dstToSphereNear, dstToSphereFar - dstToSphereNear);
		}
	}
	// Ray did not intersect sphere
	return vec2(-1.0, -1.0);
}

// https://www.shadertoy.com/view/4sBGDy
// TODO: Use https://www.shadertoy.com/view/3XdyRj in case of numerical issue
fn rayTorus(rayOrigin: vec3[f32], rayDirection: vec3[f32], torus: vec2[f32]) -> f32
{
    let po = 1.0;
    let tx = 0.0;
    let Ra2 = torus.x * torus.x;
    let ra2 = torus.y * torus.y;
    let tra = torus.x + torus.y;

    let m = dot(rayOrigin, rayOrigin);
    let n = dot(rayOrigin, rayDirection);

    // bounding sphere
	let h = n*n - m + tra*tra;
	if (h < 0.0)
		return -1.0;

	tx = -n - sqrt(h); // start ray from bounding sphere surface 
    if(tx > 0.0)     // if outside of sphere
    {
		tx -= tra*0.01; // backtrack 1%
		m  += tx*(2.0*n + tx);
		n  += tx;
		rayOrigin += tx * rayDirection;
    }
    else
 		tx = 0.0;
    
	// find quartic equation
    let k = (m - ra2 - Ra2)/2.0;
    let k3 = n;
    let k2 = n*n + Ra2*rayDirection.z*rayDirection.z + k;
    let k1 = k*n + Ra2*rayOrigin.z*rayDirection.z;
    let k0 = k*k + Ra2*rayOrigin.z*rayOrigin.z - Ra2*ra2;
	
    // prevent |c1| from being too close to zero
    if( abs(k3*(k3*k3 - k2) + k1) < 0.01 )
    {
        po = -1.0;
        let tmp=k1; k1=k3; k3=tmp;
        k0 = 1.0/k0;
        k1 = k1*k0;
        k2 = k2*k0;
        k3 = k3*k0;
    }

    let c2 = 2.0*k2 - 3.0*k3*k3;
    let c1 = k3*(k3*k3 - k2) + k1;
    let c0 = k3*(k3*(-3.0*k3*k3 + 4.0*k2) - 8.0*k1) + 4.0*k0;

    
    c2 /= 3.0;
    c1 *= 2.0;
    c0 /= 3.0;
    
    let Q = c2*c2 + c0;
    let R = 3.0*c0*c2 - c2*c2*c2 - c1*c1;
    
	
    let h = R*R - Q*Q*Q;
    let z = 0.0;
    if( h < 0.0 )
    {
    	// 4 intersections
        let sQ = sqrt(Q);
        z = 2.0*sQ*cos( acos(R/(sQ*Q)) / 3.0 );
    }
    else
    {
        // 2 intersections
        let sQ = pow( sqrt(h) + abs(R), 1.0/3.0 );
        z = sign(R)*abs( sQ + Q/sQ );
    }		
    z = c2 - z;
	
    let d1 = z   - 3.0*c2;
    let d2 = z*z - 3.0*c0;
    if( abs(d1) < 0.0001 )
    {
        if( d2 < 0.0 )
			return -1.0;

        d2 = sqrt(d2);
    }
    else
    {
        if( d1 < 0.0 )
			return -1.0;

        d1 = sqrt( d1/2.0 );
        d2 = c1/d1;
    }

    //----------------------------------
	
    let result = -1.0;

    h = d1*d1 - z + d2;
    if( h > 0.0 )
    {
        h = sqrt(h);
        let t1 = -d1 - h - k3; t1 = select(po<0.0, 2.0/t1, t1);
        let t2 = -d1 + h - k3; t2 = select(po<0.0, 2.0/t2, t2);
        if( t1 > 0.0 ) result=t1; 
        if( t2 > 0.0 ) result = select(result < 0.0, t2, min(result,t2));
    }

    h = d1*d1 - z - d2;
    if( h > 0.0 )
    {
        h = sqrt(h);
        let t1 = -d1 - h - k3; t1 = select(po<0.0, 2.0/t1, t1);
        let t2 = -d1 + h - k3; t2 = select(po<0.0, 2.0/t2, t2);
        if( t1 > 0.0 ) result = select(result < 0.0, t1, min(result, t1));
        if( t2 > 0.0 ) result = select(result < 0.0, t2, min(result,t2));
    }

    return result + tx;
}