[nzsl_version("1.1")]
module SkyboxMaterial;

import InstanceBuffer from Engine.InstanceData;

import Lighting.LightData;
import Lighting.Shadow;
import ViewerData from Engine.ViewerData;

// Material options
option HasBaseColorTexture: bool = false;

const InvalidLoc = u32.Max;

// Vertex declaration related options
option VertexColorLoc: u32 = InvalidLoc;
option VertexPositionLoc: u32 = InvalidLoc;

const HasColor = (VertexColorLoc != InvalidLoc);

[layout(std140)]
struct MaterialSettings
{
	[tag("BaseColor")]
	BaseColor: vec4[f32]
}

[tag("Scene")]
[set(0), auto_binding]
external Scene
{
	[tag("ShadowAtlas")] shadowAtlas: depth_sampler2D[f32],

	[tag("DirectionalLights")] directionalLights: storage[LightData.DirectionalLights, readonly],
	[tag("DirectionalShadowAtlasMapping")] directionalShadowAtlasMapping: storage[Shadow.DirectionalShadowAtlasMapping, readonly],
	[tag("InstanceBuffer")] instanceBuffer: storage[InstanceBuffer, readonly],
	[tag("PointLights")] pointLights: storage[LightData.PointLights, readonly],
	[tag("PointShadowAtlasMapping")] pointShadowAtlasMapping: storage[Shadow.PointShadowAtlasMapping, readonly],
	[tag("SpotLights")] spotLights: storage[LightData.SpotLights, readonly],
	[tag("SpotShadowAtlasMapping")] spotShadowAtlasMapping: storage[Shadow.SpotShadowAtlasMapping, readonly],
}

[tag("Viewer")]
[set(1), auto_binding]
external Viewer
{
	[tag("ViewerData")] viewerData: uniform[ViewerData],
}

[tag("Material")]
[set(2), auto_binding]
external Material
{
	[tag("Settings")] settings: uniform[MaterialSettings],
	[tag("BaseColorMap")] skyboxTexture: sampler_cube[f32]
}

// Fragment stage
struct VertOut
{
    [builtin(position)] position: vec4[f32],
	[location(0)] uvw: vec3[f32],
	[location(1), cond(HasColor)] color: vec4[f32],
}

struct FragOut
{
	[location(0)] color: vec4[f32],
	[builtin(frag_depth)] depth: f32
}

[entry(frag), depth_write(less)]
fn main(input: VertOut) -> FragOut
{
	let color = Material.settings.BaseColor;

	const if (HasBaseColorTexture)
		color *= Material.skyboxTexture.Sample(input.uvw);

	const if (HasColor)
		color *= input.color;

	let output: FragOut;
	output.color = color;
	output.depth = 0.0;

	return output;
}

// Vertex stage
struct VertIn
{
	[location(VertexPositionLoc)] 
	pos: vec3[f32],

	[cond(HasColor), location(VertexColorLoc)] 
	color: vec4[f32]
}

[entry(vert)]
fn main(input: VertIn) -> VertOut
{
    // Set translation part to zero
    let rotationMat = Viewer.viewerData.viewMatrix;
    rotationMat[3].xyz = vec3[f32](0.0, 0.0, 0.0);

    let output: VertOut;
    output.position = Viewer.viewerData.projectionMatrix * rotationMat * vec4[f32](input.pos, 1.0);
	output.uvw = input.pos;

	const if (HasColor)
		output.color = input.color;

    return output;
}
